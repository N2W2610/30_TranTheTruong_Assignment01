@model List<AccountVM>
@{
    ViewData["Title"] = "Account management";
    var search = ViewBag.Search as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Account management</h2>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex" role="search">
            <input type="text" name="search" value="@search" class="form-control me-2" placeholder="Search name or email..." maxlength="100" />
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </form>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">+ New account</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.AccountId</td>
                        <td>@a.AccountName</td>
                        <td>@a.AccountEmail</td>
                        <td>@a.RoleName</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-modal="#editModal"
                                    data-accountid="@a.AccountId" data-accountname="@a.AccountName"
                                    data-accountemail="@a.AccountEmail" data-accountrole="@a.AccountRole">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-modal="#deleteModal"
                                    data-id="@a.AccountId" data-label="@a.AccountName">Delete</button>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No accounts found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create dialog -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title">New account</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name</label><input name="AccountName" class="form-control" maxlength="100" required /></div>
                <div class="mb-3"><label class="form-label">Email</label><input name="AccountEmail" type="email" class="form-control" maxlength="70" required /></div>
                <div class="mb-3"><label class="form-label">Role</label>
                    <select name="AccountRole" class="form-select" required>
                        <option value="">-- select --</option>
                        <option value="1">Staff</option>
                        <option value="2">Lecturer</option>
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">Password</label><input name="AccountPassword" type="password" class="form-control" maxlength="70" required /></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<!-- Edit dialog -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Edit" method="post" class="modal-content">
            <input type="hidden" name="AccountId" />
            <div class="modal-header"><h5 class="modal-title">Edit account</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name</label><input name="AccountName" class="form-control" maxlength="100" required /></div>
                <div class="mb-3"><label class="form-label">Email</label><input name="AccountEmail" type="email" class="form-control" maxlength="70" required /></div>
                <div class="mb-3"><label class="form-label">Role</label>
                    <select name="AccountRole" class="form-select" required>
                        <option value="1">Staff</option>
                        <option value="2">Lecturer</option>
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">New password</label><input name="AccountPassword" type="password" class="form-control" maxlength="70" placeholder="Leave blank to keep the current password" /></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

<!-- Delete confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Delete" method="post" class="modal-content">
            <input type="hidden" name="id" />
            <div class="modal-header"><h5 class="modal-title">Confirm delete</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">Are you sure you want to delete the account <strong class="delete-label"></strong>?</div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete</button></div>
        </form>
    </div>
</div>
