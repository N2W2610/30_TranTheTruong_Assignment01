@model List<CategoryVM>
@{
    ViewData["Title"] = "Category management";
    var search = ViewBag.Search as string;
    var all = (List<CategoryVM>)ViewBag.AllCategories;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Category management</h2>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex" role="search">
            <input type="text" name="search" value="@search" class="form-control me-2" placeholder="Search categories..." maxlength="100" />
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </form>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">+ New category</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>ID</th><th>Name</th><th>Description</th><th>Parent</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var parent = all.FirstOrDefault(x => x.CategoryId == c.ParentCategoryId);
                    <tr>
                        <td>@c.CategoryId</td>
                        <td>@c.CategoryName</td>
                        <td>@c.CategoryDesciption</td>
                        <td>@(parent?.CategoryName ?? "-")</td>
                        <td>
                            @if (c.IsActive == true) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-modal="#editModal"
                                    data-categoryid="@c.CategoryId" data-categoryname="@c.CategoryName"
                                    data-categorydesciption="@c.CategoryDesciption"
                                    data-parentcategoryid="@c.ParentCategoryId"
                                    data-isactive="@(c.IsActive == true ? "true" : "false")">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-modal="#deleteModal"
                                    data-id="@c.CategoryId" data-label="@c.CategoryName">Delete</button>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No categories found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create dialog -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title">New category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name</label><input name="CategoryName" class="form-control" maxlength="100" required /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea name="CategoryDesciption" class="form-control" rows="3" maxlength="250" required></textarea></div>
                <div class="mb-3"><label class="form-label">Parent category</label>
                    <select name="ParentCategoryId" class="form-select">
                        <option value="">-- none --</option>
                        @foreach (var p in all) { <option value="@p.CategoryId">@p.CategoryName</option> }
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">Status</label>
                    <select name="IsActive" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<!-- Edit dialog -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Edit" method="post" class="modal-content">
            <input type="hidden" name="CategoryId" />
            <div class="modal-header"><h5 class="modal-title">Edit category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name</label><input name="CategoryName" class="form-control" maxlength="100" required /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea name="CategoryDesciption" class="form-control" rows="3" maxlength="250" required></textarea></div>
                <div class="mb-3"><label class="form-label">Parent category</label>
                    <select name="ParentCategoryId" class="form-select">
                        <option value="">-- none --</option>
                        @foreach (var p in all) { <option value="@p.CategoryId">@p.CategoryName</option> }
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">Status</label>
                    <select name="IsActive" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

<!-- Delete confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Delete" method="post" class="modal-content">
            <input type="hidden" name="id" />
            <div class="modal-header"><h5 class="modal-title">Confirm delete</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">Are you sure you want to delete the category <strong class="delete-label"></strong>?</div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete</button></div>
        </form>
    </div>
</div>
