@model NewsPageVM
@{
    ViewData["Title"] = Model.HistoryOnly ? "My news history" : "News management";
    var returnTo = Model.HistoryOnly ? "History" : "Index";
    var activeCategories = Model.Categories.Where(c => c.IsActive == true).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex" role="search">
            <input type="text" name="search" value="@Model.Search" class="form-control me-2" placeholder="Search news..." maxlength="100" />
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </form>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">+ New article</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>ID</th><th>Headline</th><th>Category</th><th>Tags</th><th>Status</th><th>Created</th><th>By</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Items)
                {
                    <tr>
                        <td>@n.NewsArticleId</td>
                        <td style="max-width:260px">@n.Headline</td>
                        <td>@(n.Category?.CategoryName ?? "-")</td>
                        <td>
                            @foreach (var t in n.Tags) { <span class="badge bg-light text-dark border">#@t.TagName</span> }
                        </td>
                        <td>
                            @if (n.NewsStatus == true) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>@n.CreatedDate?.DateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(n.CreatedBy?.AccountName ?? "-")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-modal="#editModal"
                                    data-newsarticleid="@n.NewsArticleId" data-newstitle="@n.NewsTitle"
                                    data-headline="@n.Headline" data-newscontent="@n.NewsContent"
                                    data-newssource="@n.NewsSource" data-categoryid="@n.CategoryId"
                                    data-newsstatus="@(n.NewsStatus == true ? "true" : "false")"
                                    data-tagids="@string.Join(",", n.Tags.Select(t => t.TagId))">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-modal="#deleteModal"
                                    data-id="@n.NewsArticleId" data-label="@n.Headline">Delete</button>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No news articles found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create dialog -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="Create" method="post" class="modal-content">
            <input type="hidden" name="ReturnTo" value="@returnTo" />
            <div class="modal-header"><h5 class="modal-title">New news article</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">News title</label><input name="NewsTitle" class="form-control" maxlength="400" required /></div>
                <div class="mb-3"><label class="form-label">Headline</label><input name="Headline" class="form-control" maxlength="150" required /></div>
                <div class="mb-3"><label class="form-label">Content</label><textarea name="NewsContent" class="form-control" rows="6" maxlength="4000" required></textarea></div>
                <div class="mb-3"><label class="form-label">Source</label><input name="NewsSource" class="form-control" maxlength="400" /></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Category</label>
                        <select name="CategoryId" class="form-select" required>
                            <option value="">-- select --</option>
                            @foreach (var c in activeCategories) { <option value="@c.CategoryId">@c.CategoryName</option> }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3"><label class="form-label">Status</label>
                        <select name="NewsStatus" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select>
                    </div>
                </div>
                <div class="mb-3"><label class="form-label">Tags <small class="text-muted">(Ctrl/Cmd + click for several)</small></label>
                    <select name="TagIds" class="form-select" multiple size="5">
                        @foreach (var t in Model.Tags) { <option value="@t.TagId">@t.TagName</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<!-- Edit dialog -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="Edit" method="post" class="modal-content">
            <input type="hidden" name="ReturnTo" value="@returnTo" />
            <input type="hidden" name="NewsArticleId" />
            <div class="modal-header"><h5 class="modal-title">Edit news article</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">News title</label><input name="NewsTitle" class="form-control" maxlength="400" required /></div>
                <div class="mb-3"><label class="form-label">Headline</label><input name="Headline" class="form-control" maxlength="150" required /></div>
                <div class="mb-3"><label class="form-label">Content</label><textarea name="NewsContent" class="form-control" rows="6" maxlength="4000" required></textarea></div>
                <div class="mb-3"><label class="form-label">Source</label><input name="NewsSource" class="form-control" maxlength="400" /></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Category</label>
                        <select name="CategoryId" class="form-select" required>
                            <option value="">-- select --</option>
                            @foreach (var c in activeCategories) { <option value="@c.CategoryId">@c.CategoryName</option> }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3"><label class="form-label">Status</label>
                        <select name="NewsStatus" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select>
                    </div>
                </div>
                <div class="mb-3"><label class="form-label">Tags <small class="text-muted">(Ctrl/Cmd + click for several)</small></label>
                    <select name="TagIds" class="form-select" multiple size="5">
                        @foreach (var t in Model.Tags) { <option value="@t.TagId">@t.TagName</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

<!-- Delete confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Delete" method="post" class="modal-content">
            <input type="hidden" name="id" />
            <input type="hidden" name="returnTo" value="@returnTo" />
            <div class="modal-header"><h5 class="modal-title">Confirm delete</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">Are you sure you want to delete the article <strong class="delete-label"></strong>?</div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete</button></div>
        </form>
    </div>
</div>
